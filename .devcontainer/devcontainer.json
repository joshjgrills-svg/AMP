{
  "name": "AMP + REA",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "jdkDistro": "ms" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "postCreateCommand": "sudo bash .devcontainer/install-rea-tools.sh && npm install -g @anthropic-ai/claude-code && npm ci",
  "containerEnv": {
    "GHIDRA_INSTALL_DIR": "/opt/ghidra_12.1.4_PUBLIC",
    "REA_JADX_MCP_JAR": "/opt/rea-tools/jadx-headless-mcp-0.7.1-all.jar",
    "REA_BROWSER_EXECUTABLE": "/usr/bin/chromium"
  },
  "customizations": {
    "vscode": { "extensions": ["anthropic.claude-code"] }
  }
}

# AMP environment variables — example file
#
# Copy this file to `.env.local` for local development and fill in real values.
# `.env.local` is gitignored (per .gitignore line: `.env*`) and must never be
# committed. Production / Preview / Development values in deployed environments
# are managed in the Vercel dashboard.
#
# Constitution Section 4.1: secrets live in environment variables only —
# never in code, never in committed files, never in client-side bundles.

# ---------------------------------------------------------------------------
# Supabase (AMP project)
# ---------------------------------------------------------------------------

# Supabase project URL. Public, safe to expose to the browser (the `NEXT_PUBLIC_`
# prefix opts into client-side inlining at build time).
# Where to get it: Supabase dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous (publishable) key. Public, safe to expose to the browser;
# all access is enforced by Row-Level Security policies per Constitution §1.1.
# Where to get it: Supabase dashboard → Project Settings → API → anon public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SECRET — server-side only. Bypasses RLS. Used by
# the admin client in lib/supabase.ts (lazy via Proxy so it never reaches the
# browser bundle). Treat this like a production password.
# Where to get it: Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Retell AI (voice agent platform)
# ---------------------------------------------------------------------------

# Retell API key. SECRET. Used by lib/retell.ts and the webhook handler at
# app/api/webhooks/retell/route.ts for inbound call processing and outbound
# Retell API calls.
# Where to get it: Retell dashboard → API Keys.
RETELL_API_KEY=

# ---------------------------------------------------------------------------
# Twilio (telephony)
# ---------------------------------------------------------------------------

# Twilio account SID. Treat as sensitive (it's the account identifier paired
# with the auth token below).
# Where to get it: Twilio Console → Account Info → Account SID.
TWILIO_ACCOUNT_SID=

# Twilio auth token. SECRET. Paired with the SID for all Twilio REST API
# requests in lib/twilio.ts and the operational scripts.
# Where to get it: Twilio Console → Account Info → Auth Token (rotate if exposed).
TWILIO_AUTH_TOKEN=

# AMP phone number in E.164 format (e.g. +12494448711). Layer 1 per ADR-008 —
# it is AMP's number (Twilio is the provider; the credential is TWILIO_AUTH_TOKEN
# above). Default `from` for outbound SMS in lib/twilio.ts; consumed by the
# bind-phone operational script.
# Where to get it: Twilio Console → Phone Numbers → Active Numbers.
AMP_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# AMP agents (Retell identifiers — current live testbed)
# ---------------------------------------------------------------------------

# Default AMP Retell agent ID, V1 (Layer 1 per ADR-008 — Plumbing vertical is
# descriptive content in the display name "AMP - Plumbing - V1", not a prefix
# slot). Live ID as of 2026-05-23 is `agent_0e211c256211ef2ead23cc8375`.
# Consumed by the bind-phone operational script.
# Where to get it: Retell dashboard → Agents, or via Retell `/list-agents` API.
AMP_AGENT_DEFAULT_V1=
